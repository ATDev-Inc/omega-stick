{
  "version": 1,
  "name": "set_deadzone over the firmware limits is refused as invalid",
  "steps": [
    { "at_ms": 0, "pattern": "calibrate" },
    { "at_ms": 500, "action": "recalibrate" },
    { "at_ms": 1000, "action": "set_deadzone", "value": { "center": 0.9 }, "expect_reply": "invalid" },
    { "at_ms": 1100, "action": "set_deadzone", "value": { "range": 0.5 }, "expect_reply": "invalid" },
    { "at_ms": 1200, "action": "set_deadzone", "value": { "center": -0.1, "range": 0.05 }, "expect_reply": "invalid" },
    { "at_ms": 1300, "action": "set_deadzone", "value": { "center": 0.1, "range": 0.05 } },
    { "at_ms": 1400, "action": "set_deadzone", "value": { "center": 0.5, "range": 0.1 } },
    { "at_ms": 40000, "expect": { "calibrated": true } }
  ]
}
