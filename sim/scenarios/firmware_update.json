{
  "version": 1,
  "name": "a firmware update installs, boots pending, is confirmed by the host, and can be reverted",
  "steps": [
    { "at_ms": 0, "pattern": "calibrate" },
    { "at_ms": 500, "action": "recalibrate" },
    { "at_ms": 50000, "expect": { "calibrated": true, "fw_slot": "ota_0", "fw_pending": false } },
    { "at_ms": 51000, "action": "revert", "expect_reply": "error" },
    { "at_ms": 52000, "action": "flash", "version": "9.9.9-sim" },
    { "at_ms": 55000, "expect": { "fw_slot": "ota_1", "fw_pending": true, "fw_version": "9.9.9-sim", "calibrated": true } },
    { "at_ms": 70000, "expect": { "fw_slot": "ota_1", "fw_pending": true, "fw_version": "9.9.9-sim" } },
    { "at_ms": 71000, "action": "mark_valid" },
    { "at_ms": 72000, "expect": { "fw_slot": "ota_1", "fw_pending": false, "fw_version": "9.9.9-sim" } },
    { "at_ms": 73000, "action": "revert" },
    { "at_ms": 77000, "expect": { "fw_slot": "ota_0", "fw_pending": true } },
    { "at_ms": 78000, "action": "mark_valid" },
    { "at_ms": 80000, "expect": { "fw_slot": "ota_0", "fw_pending": false } }
  ]
}
