{
  "version": 1,
  "name": "fresh board calibrates, then pushes move the mouse",
  "steps": [
    { "at_ms": 0, "pattern": "calibrate" },
    { "at_ms": 40000, "expect": { "calibrated": true, "center_max": 0.05, "mode": "mouse" } },
    { "at_ms": 41000, "stick": [0, 0] },
    { "at_ms": 41500, "stick": [0.6, 0] },
    { "at_ms": 42500, "stick": [0.6, 0] },
    { "at_ms": 43000, "expect": { "mouse_moved": "right", "clicked": "none", "sensor_fault": false } },
    { "at_ms": 43500, "stick": [0, 0.6] },
    { "at_ms": 44500, "stick": [0, 0.6] },
    { "at_ms": 45000, "expect": { "mouse_moved": "up" } },
    { "at_ms": 45500, "stick": [-0.6, 0] },
    { "at_ms": 46500, "stick": [-0.6, 0] },
    { "at_ms": 47000, "expect": { "mouse_moved": "left" } },
    { "at_ms": 47500, "stick": [0, -0.6] },
    { "at_ms": 48500, "stick": [0, -0.6] },
    { "at_ms": 49000, "expect": { "mouse_moved": "down" } },
    { "at_ms": 49500, "stick": [0, 0] },
    { "at_ms": 49600, "expect": { "neutral": false } },
    { "at_ms": 51000, "expect": { "mouse_moved": "none", "neutral": true } }
  ]
}
