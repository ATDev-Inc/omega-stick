{
  "version": 1,
  "name": "a fresh board waits quiet until the console calibrates it, then pushes move the mouse",
  "steps": [
    { "at_ms": 0, "stick": [0, 0] },
    { "at_ms": 1000, "expect": { "calibrated": false, "needs_calibration": true, "mode": "mouse" } },
    { "at_ms": 1500, "stick": [0.6, 0] },
    { "at_ms": 3000, "expect": { "neutral": true, "mouse_moved": "none", "clicked": "none" } },
    { "at_ms": 3500, "pattern": "nudge_up" },
    { "at_ms": 4500, "expect": { "neutral": true, "clicked": "none", "sensor_observed": true } },
    { "at_ms": 5000, "pattern": "calibrate" },
    { "at_ms": 5500, "action": "recalibrate" },
    { "at_ms": 55000, "expect": { "calibrated": true, "needs_calibration": false, "center_max": 0.05, "mode": "mouse" } },
    { "at_ms": 56000, "stick": [0, 0] },
    { "at_ms": 56500, "stick": [0.6, 0] },
    { "at_ms": 57500, "stick": [0.6, 0] },
    { "at_ms": 58000, "expect": { "mouse_moved": "right", "clicked": "none", "sensor_fault": false } },
    { "at_ms": 58500, "stick": [0, 0.6] },
    { "at_ms": 59500, "stick": [0, 0.6] },
    { "at_ms": 60000, "expect": { "mouse_moved": "up" } },
    { "at_ms": 60500, "stick": [-0.6, 0] },
    { "at_ms": 61500, "stick": [-0.6, 0] },
    { "at_ms": 62000, "expect": { "mouse_moved": "left" } },
    { "at_ms": 62500, "stick": [0, -0.6] },
    { "at_ms": 63500, "stick": [0, -0.6] },
    { "at_ms": 64000, "expect": { "mouse_moved": "down" } },
    { "at_ms": 64500, "stick": [0, 0] },
    { "at_ms": 64600, "expect": { "neutral": false } },
    { "at_ms": 66000, "expect": { "mouse_moved": "none", "neutral": true } },
    { "at_ms": 67000, "action": "restart" },
    { "at_ms": 70000, "expect": { "calibrated": true, "needs_calibration": false } }
  ]
}
