{
  "version": 1,
  "name": "switching to xac restarts into xac mode and the gamepad follows the stick",
  "steps": [
    { "at_ms": 0, "pattern": "calibrate" },
    { "at_ms": 40000, "expect": { "calibrated": true, "mode": "mouse" } },
    { "at_ms": 41000, "action": "set_mode", "value": "xac" },
    { "at_ms": 42000, "stick": [0.5, 0] },
    { "at_ms": 45000, "expect": { "mode": "xac", "calibrated": true, "xac_x": 0.5, "xac_y": 0, "sensor_fault": false } },
    { "at_ms": 45500, "stick": [0.5, 0] },
    { "at_ms": 46000, "stick": [0, 0.5] },
    { "at_ms": 47500, "stick": [0, 0.5] },
    { "at_ms": 48000, "expect": { "xac_x": 0, "xac_y": 0.5 } },
    { "at_ms": 49000, "action": "set_mode", "value": "mouse" },
    { "at_ms": 52000, "expect": { "mode": "mouse" } }
  ]
}
