{
  "version": 1,
  "name": "nudging the stick produces clicks",
  "steps": [
    { "at_ms": 0, "pattern": "calibrate" },
    { "at_ms": 500, "action": "recalibrate" },
    { "at_ms": 40000, "expect": { "calibrated": true } },
    { "at_ms": 41000, "pattern": "nudge_right" },
    { "at_ms": 42000, "expect": { "clicked": "right" } },
    { "at_ms": 43000, "pattern": "nudge_up" },
    { "at_ms": 44000, "expect": { "clicked": "left" } },
    { "at_ms": 45000, "pattern": "rest" },
    { "at_ms": 46000, "expect": { "clicked": "none", "neutral": true } }
  ]
}
