{
  "version": 1,
  "name": "a recalibration during a sweep is refused as busy",
  "steps": [
    { "at_ms": 0, "pattern": "calibrate" },
    { "at_ms": 10000, "action": "recalibrate", "expect_reply": "busy" },
    { "at_ms": 40000, "expect": { "calibrated": true } },
    { "at_ms": 41000, "action": "recalibrate" },
    { "at_ms": 41100, "action": "recalibrate", "expect_reply": "busy" },
    { "at_ms": 55000, "action": "recalibrate", "expect_reply": "busy" },
    { "at_ms": 80000, "expect": { "calibrated": true, "center_max": 0.05 } },
    { "at_ms": 81000, "action": "recalibrate" }
  ]
}
