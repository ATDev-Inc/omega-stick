{
  "version": 1,
  "name": "a missing sensor gives a fault and a neutral output, and recovery restores it",
  "steps": [
    { "at_ms": 0, "pattern": "calibrate" },
    { "at_ms": 500, "action": "recalibrate" },
    { "at_ms": 50000, "expect": { "calibrated": true } },
    { "at_ms": 51000, "stick": [0.8, 0] },
    { "at_ms": 52000, "fault": "no_response" },
    { "at_ms": 52100, "expect": { "sensor_fault": true } },
    { "at_ms": 53000, "expect": { "sensor_fault": true, "neutral": true, "mouse_moved": "none" } },
    { "at_ms": 53100, "fault": "ok" },
    { "at_ms": 53500, "expect": { "sensor_fault": false } },
    { "at_ms": 54000, "stick": [0.8, 0] },
    { "at_ms": 57000, "stick": [0.8, 0] },
    { "at_ms": 57500, "expect": { "sensor_fault": false, "mouse_moved": "right" } }
  ]
}
