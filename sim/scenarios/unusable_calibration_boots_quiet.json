{
  "version": 1,
  "name": "a saved calibration below the noise ratio boots quiet until a recalibration fixes it",
  "steps": [
    { "at_ms": 0, "pattern": "calibrate" },
    { "at_ms": 500, "action": "recalibrate" },
    { "at_ms": 50000, "expect": { "calibrated": true, "needs_calibration": false } },
    { "at_ms": 50500, "stick": [0, 0] },
    { "at_ms": 51000, "action": "plant_unusable_calibration" },
    { "at_ms": 51500, "action": "restart" },
    { "at_ms": 54000, "expect": { "calibrated": false, "needs_calibration": true } },
    { "at_ms": 54500, "stick": [0.6, 0] },
    { "at_ms": 56000, "expect": { "neutral": true, "mouse_moved": "none" } },
    { "at_ms": 56500, "stick": [0, 0] },
    { "at_ms": 57000, "action": "recalibrate" },
    { "at_ms": 90000, "expect": { "calibrated": false, "needs_calibration": true } },
    { "at_ms": 90500, "stick": [0.6, 0] },
    { "at_ms": 92000, "expect": { "neutral": true, "mouse_moved": "none" } },
    { "at_ms": 92600, "pattern": "calibrate" },
    { "at_ms": 93000, "action": "recalibrate" },
    { "at_ms": 130000, "expect": { "calibrated": true, "needs_calibration": false } },
    { "at_ms": 130500, "stick": [0, 0] },
    { "at_ms": 131000, "stick": [0.6, 0] },
    { "at_ms": 132500, "expect": { "mouse_moved": "right", "neutral": false } }
  ]
}
