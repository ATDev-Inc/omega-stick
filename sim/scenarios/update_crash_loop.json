{
  "version": 1,
  "name": "an update that crashes on boot is reverted",
  "steps": [
    { "at_ms": 0, "pattern": "calibrate" },
    { "at_ms": 500, "action": "recalibrate" },
    { "at_ms": 50000, "expect": { "calibrated": true } },
    { "at_ms": 51000, "next_image": "crash_loop" },
    { "at_ms": 52000, "action": "flash", "version": "9.9.9-sim" },
    { "at_ms": 60000, "expect": { "fw_slot": "ota_0", "fw_pending": false, "calibrated": true } }
  ]
}
