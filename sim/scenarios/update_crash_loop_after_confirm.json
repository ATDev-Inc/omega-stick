{
  "version": 1,
  "name": "a confirmed image that crash-loops hands over, and nothing undoes the handover",
  "steps": [
    { "at_ms": 0, "pattern": "calibrate" },
    { "at_ms": 40000, "expect": { "calibrated": true } },
    { "at_ms": 41000, "next_image": "crash_when_confirmed" },
    { "at_ms": 42000, "action": "flash", "version": "9.9.9-sim" },
    { "at_ms": 50000, "expect": { "fw_slot": "ota_1", "fw_pending": true, "fw_version": "9.9.9-sim" } },
    { "at_ms": 51000, "action": "mark_valid" },
    { "at_ms": 52000, "expect": { "fw_slot": "ota_1", "fw_pending": false } },
    { "at_ms": 53000, "action": "restart" },
    { "at_ms": 60000, "expect": { "fw_slot": "ota_0", "fw_pending": false, "calibrated": true } },
    { "at_ms": 200000, "expect": { "fw_slot": "ota_0", "fw_pending": false, "calibrated": true } },
    { "at_ms": 260000, "expect": { "fw_slot": "ota_0", "fw_pending": false } }
  ]
}
