{
  "version": 1,
  "name": "an update whose sensor fails is never confirmed and is rolled back at the deadline",
  "steps": [
    { "at_ms": 0, "pattern": "calibrate" },
    { "at_ms": 500, "action": "recalibrate" },
    { "at_ms": 40000, "expect": { "calibrated": true } },
    { "at_ms": 41000, "next_image": "fail_self_test" },
    { "at_ms": 42000, "action": "flash", "version": "9.9.9-sim" },
    { "at_ms": 60000, "expect": { "fw_slot": "ota_1", "fw_pending": true, "sensor_fault": true } },
    { "at_ms": 100000, "expect": { "fw_slot": "ota_1", "fw_pending": true, "sensor_fault": true } },
    { "at_ms": 190000, "expect": { "fw_slot": "ota_0", "fw_pending": false, "sensor_fault": false, "calibrated": true } }
  ]
}
