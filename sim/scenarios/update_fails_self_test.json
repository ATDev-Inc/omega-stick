{
  "version": 1,
  "name": "an update that never passes its self-test is rolled back",
  "steps": [
    { "at_ms": 0, "pattern": "calibrate" },
    { "at_ms": 40000, "expect": { "calibrated": true } },
    { "at_ms": 41000, "next_image": "fail_self_test" },
    { "at_ms": 42000, "action": "flash", "version": "9.9.9-sim" },
    { "at_ms": 50000, "expect": { "fw_slot": "ota_1", "fw_pending": true } },
    { "at_ms": 150000, "expect": { "fw_slot": "ota_0", "fw_pending": false, "calibrated": true } }
  ]
}
