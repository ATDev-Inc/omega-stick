{
  "version": 1,
  "name": "an update that starts polling late and whose sensor then fails is never observed healthy and is rolled back",
  "steps": [
    { "at_ms": 0, "pattern": "calibrate" },
    { "at_ms": 500, "action": "recalibrate" },
    { "at_ms": 40000, "expect": { "calibrated": true } },
    { "at_ms": 41000, "next_image": "slow_sensor_fail" },
    { "at_ms": 42000, "action": "flash", "version": "9.9.9-sim" },
    { "at_ms": 44000, "expect": { "fw_slot": "ota_1", "fw_pending": true, "sensor_observed": false, "sensor_fault": false } },
    { "at_ms": 60000, "expect": { "fw_slot": "ota_1", "fw_pending": true, "sensor_observed": false, "sensor_fault": true } },
    { "at_ms": 100000, "expect": { "fw_slot": "ota_1", "fw_pending": true, "sensor_observed": false, "sensor_fault": true } },
    { "at_ms": 190000, "expect": { "fw_slot": "ota_0", "fw_pending": false, "sensor_fault": false, "calibrated": true } }
  ]
}
